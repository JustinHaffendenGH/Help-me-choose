{
  "name": "help-me-choose-proxy",
  "version": "0.1.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:debug": "DEBUG_MODE=true node --inspect=0.0.0.0:9229 server.js",
    "start:debug-brk": "DEBUG_MODE=true node --inspect-brk=0.0.0.0:9229 server.js",
    "start:daemon": "nohup node server.js > proxy.log 2>&1 &",
    "start:debug-daemon": "DEBUG_MODE=true nohup node --inspect=0.0.0.0:9229 server.js > proxy.log 2>&1 &",
    "debug:chrome": "node debug-helper.js",
    "debug:full": "npm run start:debug & sleep 2 && npm run debug:chrome",
    "stop:daemon": "pids=$(lsof -ti :3000) || true; if [ -n \"$pids\" ]; then kill $pids; fi",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ scripts/*.js server.js",
    "lint:fix": "eslint src/ scripts/*.js server.js --fix",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"*.js\" \"*.json\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsdom": "^21.1.2",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@vitest/ui": "^4.0.1",
    "chrome-remote-interface": "^0.33.3",
    "eslint": "^9.34.0",
    "jest": "^30.1.1",
    "prettier": "^3.6.2",
    "vite": "^7.1.11",
    "vitest": "^4.0.1"
  }
}
